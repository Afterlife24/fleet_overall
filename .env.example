# Copy to .env (gitignored) and fill in. Never commit real credentials.
# Values containing CHANGE_ME are local-only placeholders; the server rejects
# them in production.

# ---- Frontend (build-time, public by design) ----
# Mapbox access token used by the Fleet Map and Truck Tracking pages.
VITE_MAPBOX_TOKEN=

# ---- Server: process ----
# development | test | production
NODE_ENV=development
HOST=127.0.0.1
PORT=3000
# Public base URL of the app (used for links and OIDC redirects).
APP_PUBLIC_URL=http://localhost:5173

# ---- Server: database ----
# Runtime role (fleet_app): least privilege, NOBYPASSRLS, not the table owner.
DATABASE_URL=postgres://fleet_app:CHANGE_ME_LOCAL@localhost:5432/fleet_local
# Migration role (fleet_migrator): used only by `npm run db:migrate`.
MIGRATION_DATABASE_URL=postgres://fleet_migrator:CHANGE_ME_LOCAL@localhost:5432/fleet_local
# Integration tests only. The database name must contain "fleet_test".
TEST_DATABASE_URL=postgres://fleet_migrator:CHANGE_ME_LOCAL@localhost:5432/fleet_test
# disable | require | verify-ca | verify-full (production requires verify-full)
DATABASE_SSL_MODE=disable
# Path to the CA bundle for verify-ca / verify-full.
DATABASE_CA_FILE=
DATABASE_POOL_MAX=10

# ---- Server: file storage ----
# local | memory | s3 (production requires s3)
STORAGE_DRIVER=local
# Absolute private folder outside dist/, src/ and any public directory.
LOCAL_STORAGE_ROOT=
# Maximum upload size in bytes (default 10 MiB).
MAX_UPLOAD_BYTES=10485760
# Required only when STORAGE_DRIVER=s3.
AWS_REGION=
S3_BUCKET=
S3_KEY_PREFIX=

# ---- Server: authentication ----
# oidc | development-fixture (development-fixture is rejected in production)
AUTH_MODE=development-fixture
ALLOW_DEV_AUTH=false
# Id of the preseeded fixture user used by development-fixture auth.
DEV_AUTH_USER_ID=
# Required when AUTH_MODE=oidc.
OIDC_ISSUER=
OIDC_AUDIENCE=
OIDC_JWKS_URL=

# ---- Server: uploaded file verification ----
# development-stub | approved-scanner (development-stub is rejected in production)
FILE_SCAN_DRIVER=development-stub

# Maximum JSON request body in bytes (default 1048576)
JSON_BODY_LIMIT_BYTES=
# Bounded wait for in-flight requests on SIGTERM/SIGINT, ms (default 10000)
SHUTDOWN_TIMEOUT_MS=
